APP_PORT=7777

# SQLAlchemy async PostgreSQL URL. For the local Docker database, use port 5433.
DATABASE_URL=postgresql+psycopg_async://intellistudy:password@127.0.0.1:5433/intellistudy

# Create a key in Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Authentication session cookie settings.
AUTH_COOKIE_NAME=courseo_session
AUTH_SESSION_DAYS=30
# Keep false for local HTTP; set true when production is served over HTTPS.
AUTH_COOKIE_SECURE=True

# Comma-separated frontend origins allowed to call this API with cookies. No trailing slash.
# Example (Render): https://courseo-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=

# Password reset link base URL (no trailing slash).
FRONTEND_URL=https://courseo-frontend.onrender.com
PASSWORD_RESET_EXPIRE_MINUTES=60

# Email sandbox credentials (Mailtrap)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_username
SMTP_PASSWORD=your_password
# For testing, it can be any value, don't need to be a valid email address.
# For production, the email domain must be validated with DNS (SPF, DKIM, DMARC) records setup.
EMAIL_FROM=your_email@example.com
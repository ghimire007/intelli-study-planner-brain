APP_PORT=7777

# SQLAlchemy async PostgreSQL URL. For the local Docker database, use port 5433.
DATABASE_URL=postgresql+psycopg_async://intellistudy:password@127.0.0.1:5433/intellistudy

# Create a key in Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Authentication session cookie settings.
AUTH_COOKIE_NAME=courseo_session
AUTH_SESSION_DAYS=30
# Keep false for local HTTP; set true when production is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Comma-separated frontend origins allowed to call this API with cookies. No trailing slash.
# Example (Render): https://courseo-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

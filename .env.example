APP_PORT=7777

# SQLAlchemy async PostgreSQL URL. For the local Docker database, use port 5433.
DATABASE_URL=postgresql+psycopg_async://intellistudy:password@127.0.0.1:5433/intellistudy

# Create a key in Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Authentication session cookie settings.
AUTH_COOKIE_NAME=courseo_session
AUTH_SESSION_DAYS=30
# Keep false for local HTTP; set true when production is served over HTTPS.
AUTH_COOKIE_SECURE=false
# "lax" works when the frontend is served from the same site as the API (local dev,
# or the built-in page at /). Set "none" when they are different sites — two
# *.onrender.com services are, because onrender.com is a public suffix — otherwise
# the browser drops the cookie on every cross-site call and everything 401s.
# "none" is only honoured together with AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAMESITE=lax

# Comma-separated frontend origins allowed to call this API with cookies. No trailing slash.
# Example (Render): https://courseo-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Key vault ─────────────────────────────────────────────────────────────────
# Wraps each student's stored API key. Generate one with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Format "1:<base64>,2:<base64>" for rotation; a bare value is read as version 1.
# LOSING THIS MAKES EVERY STORED KEY UNRECOVERABLE. Keep it in the deploy
# environment, back it up separately from the database, and never commit it.
SECRETS_MASTER_KEYS=
SECRETS_ACTIVE_KEY_VERSION=1

# Check a key against its provider before saving it, so typos surface immediately.
VAULT_VERIFY_ON_WRITE=true
# Per-user hourly caps, so these endpoints can't be used as a key-validity oracle.
VAULT_WRITE_LIMIT_PER_HOUR=20
VAULT_VERIFY_LIMIT_PER_HOUR=30

# Let students with no Gemini key of their own fall back to GEMINI_API_KEY above,
# so the advisor works before anyone has added a key. A student's own key always
# wins when they have one. Set false to force everyone onto their own quota.
ALLOW_SYSTEM_FALLBACK_KEY=true

# ── Where a student's key is kept ────────────────────────────────────────────
# Both backends seal the key with SECRETS_MASTER_KEYS first — the difference is
# only where the resulting ciphertext is kept.
# "local"     — in the llm_credential row (no network on the chat path).
# "infisical" — as an Infisical secret; the row keeps metadata and its name.
#               Infisical never sees a usable key, so reading one needs both the
#               Infisical project AND this server's master key.
# Existing rows remember their own backend, so switching affects new keys only.
SECRET_BACKEND=local
INFISICAL_HOST=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
# Folders must already exist in Infisical, so "/" is the safe default.
INFISICAL_SECRET_PATH=/
